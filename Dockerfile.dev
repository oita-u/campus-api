FROM golang:1.24-alpine

RUN apk update && apk add --no-cache git

WORKDIR /app

# VCSスタンプエラー(exit status 128)を回避するために設定
ENV GOFLAGS="-buildvcs=false"

# Air のインストール
# latest ではなく、Go 1.24 で動作するバージョン(v1.61.7など)を指定します
RUN go install github.com/air-verse/air@v1.61.7

# モジュール定義のコピーとダウンロード
COPY go.mod go.sum* ./
RUN go mod download

# ソースコードのコピー
COPY . .

# Air の起動
CMD ["air", "-c", ".air.toml"]
